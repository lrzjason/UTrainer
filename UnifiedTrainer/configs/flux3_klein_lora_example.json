{
    "model": "flux3_klein",
    "model_path": "E:/hf_models/flux-3-image-klein",
    "vae_path": "E:/hf_models/flux-3-image-klein/vae",
    "text_encoder_path": "E:/hf_models/flux-3-image-klein/text_encoder",
    "tokenizer_path": "E:/hf_models/flux-3-image-klein/tokenizer",
    "processor_path": "E:/hf_models/flux-3-image-klein/processor",
    "scheduler_path": "E:/hf_models/flux-3-image-klein/scheduler",

    "flow_map": true,
    "max_sequence_length": 8192,
    "pad_multiple": 80,
    "image_rope_scale": 0.5,

    "timestep_shift_mode": "flow_shift",
    "flow_shift": 16.0,
    "_timestep_note": "Training sigma sampling: mu = ln(flow_shift). 16 = the official workflow's inference alpha (mu 2.77259, mean sigma ~0.92). 6.93 = FLUX.3 reference, 2.5 = krea2, 1.0 = plain logit-normal.",

    "scheduler_shift": 16.0,
    "_scheduler_shift_note": "Inference/validation timestep shift (recipe alpha): 16 = official workflow (mu = ln 16 = 2.77259), 6.93 = the model's reference shift. Only used when scheduler_path does not resolve to a real scheduler directory.",

    "data": {
        "cache_dir": "cache/flux3_klein_lora",
        "rebuild_index": false,
        "dataset_configs": [
            {
                "train_data_dir": "E:/images/flux3/train",
                "resolution": 1024,
                "repeats": 1,
                "recreate_cache": false,
                "recreate_latents": false,
                "recreate_embeddings": false,
                "image_configs": {
                    "T": {
                        "suffix": "_t"
                    }
                },
                "target_configs": {
                    "T": [
                        {
                            "image": "T"
                        }
                    ]
                },
                "caption_configs": {
                    "train_T": {
                        "ext": ".txt",
                        "image": "T"
                    }
                },
                "batch_configs": [
                    {
                        "target_config": "T",
                        "caption_config": "train_T",
                        "caption_dropout": 0.1
                    }
                ]
            }
        ],
        "num_workers": 0
    },

    "losses": [
        {
            "type": "flow_matching",
            "weight": 1
        }
    ],

    "training": {
        "network_type": "lora",
        "lora_rank": 16,
        "lora_alpha": 16,
        "lora_target_modules": [
            "to_q",
            "to_k",
            "to_v",
            "to_out"
        ],
        "batch_size": 1,
        "learning_rate": 0.0001,
        "max_steps": -1,
        "num_epochs": 3,
        "optimizer": "adamw8bit",
        "gradient_checkpointing": true,
        "quantize": "torchao_float8",
        "max_grad_norm": 1,
        "lr_scheduler": "constant"
    },

    "output": {
        "dir": "output/flux3_klein_lora",
        "save_name": "lora",
        "save_every_epoch": 1,
        "save_start_epoch": 0
    },

    "reporter": {
        "type": "tensorboard",
        "port": 6006,
        "log_dir": null,
        "log_every": 1
    },

    "validation": {
        "val_every_epoch": 1,
        "val_seed": 42,
        "generate_images": true,
        "resolution": 1024
    }
}
