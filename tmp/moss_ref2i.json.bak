      "widgets_values": [
        "{\n  \"summary\": \"In the marble-bathroom mirror selfie, change the small crystal-covered flap bag hanging at her hip into a smooth black leather flap bag with a quilted diamond pattern, a polished silver turn-lock and the same thin silver chain strap, keeping the same compact rounded silhouette and position, and leave her long dark hair, rhinestone choker, plunging black cut-out dress, orange iPhone, marble walls, towel rail and black vanity untouched.\",\n  \"items\": [\n    {\n      \"operation\": \"\",\n      \"color\": \"black\",\n      \"bbox\": [\n        -696,\n        -464,\n        696,\n        464\n      ],\n      \"ref_index\": -1,\n      \"z_index\": -1,\n      \"caption\": \"Layout annotation: black canvas with solid color blocks mapping each edit region; colors match the items in this JSON.\"\n    },\n    {\n      \"operation\": \"\",\n      \"color\": \"gray\",\n      \"bbox\": [\n        -696,\n        -464,\n        696,\n        464\n      ],\n      \"ref_index\": 2,\n      \"z_index\": 0,\n      \"caption\": \"A polished bathroom mirror selfie of a young woman with long, glossy dark-brown hair parted in the middle. She wears a black evening dress with a halter neckline that plunges to the waist in a deep V, wide side cut-outs at the midriff and a knotted draped skirt, accessorised with a wide rhinestone choker and a matching sparkly bracelet. In her right hand she holds a bright orange iPhone with three large camera lenses, and a small rhinestone-covered bag hangs at her hip. She smiles softly at her reflection with natural makeup, filled brows and a nude-pink lip. Behind her, a luxurious dark marble bathroom with grey veined walls, a black marble vanity, a white towel, a chrome faucet and warm recessed lighting gives the image a high-end, quietly glamorous feel.\"\n    },\n    {\n      \"operation\": \"change\",\n      \"color\": \"red\",\n      \"bbox\": [\n        104,\n        94,\n        544,\n        353\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 1,\n      \"caption\": \"In the marble-bathroom mirror selfie, change the small crystal-covered flap bag hanging at her hip into a smooth black leather flap bag with a quilted diamond pattern, a polished silver turn-lock and the same thin silver chain strap, keeping the same compact rounded silhouette and position, and leave her long dark hair, rhinestone choker, plunging black cut-out dress, orange iPhone, marble walls, towel rail and black vanity untouched.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"blue\",\n      \"bbox\": [\n        -231,\n        -364,\n        696,\n        281\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the black plunging cut-out dress unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"green\",\n      \"bbox\": [\n        -636,\n        -307,\n        84,\n        136\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the long glossy dark hair unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"yellow\",\n      \"bbox\": [\n        192,\n        -464,\n        696,\n        -16\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the black vanity cabinetry unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"magenta\",\n      \"bbox\": [\n        -356,\n        6,\n        17,\n        253\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the right arm holding the phone unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"cyan\",\n      \"bbox\": [\n        114,\n        47,\n        465,\n        253\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the rhinestone mini bag unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"orange\",\n      \"bbox\": [\n        -696,\n        -464,\n        -140,\n        -344\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the dark mirror frame unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"purple\",\n      \"bbox\": [\n        -454,\n        66,\n        -86,\n        225\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the orange iPhone unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"lime\",\n      \"bbox\": [\n        -534,\n        -246,\n        -231,\n        -55\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the woman's face unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"pink\",\n      \"bbox\": [\n        16,\n        -464,\n        207,\n        -224\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the white sink basin unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"teal\",\n      \"bbox\": [\n        -384,\n        206,\n        -206,\n        281\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the white towel unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"brown\",\n      \"bbox\": [\n        -31,\n        146,\n        82,\n        259\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the rhinestone bracelet unchanged.\"\n    }\n  ]\n}"
