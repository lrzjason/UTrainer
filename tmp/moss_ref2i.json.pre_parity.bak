      "widgets_values": [
        "{\n  \"summary\": \"On the dark wet stone pavement at the lower left of the alley, add a single scuffed white leather football boot lying on its side just beyond the yellow and green ball, with a soft contact shadow pooling under it and a faint wet reflection on the stone, keeping the standing man, the ball itself, the spray-painted mural and the rest of the pavement untouched.\",\n  \"items\": [\n    {\n      \"operation\": \"\",\n      \"color\": \"black\",\n      \"bbox\": [\n        -640,\n        -480,\n        640,\n        480\n      ],\n      \"ref_index\": -1,\n      \"z_index\": -1,\n      \"caption\": \"Layout annotation: black canvas with solid color blocks mapping each edit region; colors match the items in this JSON.\"\n    },\n    {\n      \"operation\": \"\",\n      \"color\": \"gray\",\n      \"bbox\": [\n        -640,\n        -480,\n        640,\n        480\n      ],\n      \"ref_index\": 2,\n      \"z_index\": 0,\n      \"caption\": \"A full-length street portrait of a young man standing in front of a large painted wall. Behind him a giant mural shows the weathered face of a dark-haired man in the colours of the Portuguese flag, framed by red, green and yellow paint splatters and drips. The standing man wears a red and green Portugal football jersey with a yellow number 7 and the FPF crest, loose khaki trousers and black canvas sneakers with white stripes, hands pushed into his pockets. To the right a Portuguese coat of arms emblem and the words PORTUGAL, JOGA BONITO and PORTUGAL 2026 are painted in green, red and yellow beside a green statue silhouette. A yellow and green football rests on the wet, reflective pavement in the foreground.\"\n    },\n    {\n      \"operation\": \"add\",\n      \"color\": \"red\",\n      \"bbox\": [\n        453,\n        -480,\n        640,\n        -269\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 1,\n      \"caption\": \"On the dark wet stone pavement at the lower left of the alley, add a single scuffed white leather football boot lying on its side just beyond the yellow and green ball, with a soft contact shadow pooling under it and a faint wet reflection on the stone, keeping the standing man, the ball itself, the spray-painted mural and the rest of the pavement untouched.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"blue\",\n      \"bbox\": [\n        147,\n        -444,\n        359,\n        -46\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the text \\\"PORTUGAL 2026\\\" unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"green\",\n      \"bbox\": [\n        240,\n        257,\n        333,\n        463\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the text \\\"JOGA BONITO\\\" unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"yellow\",\n      \"bbox\": [\n        -179,\n        276,\n        -115,\n        473\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the text \\\"PORTUGAL\\\" unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"magenta\",\n      \"bbox\": [\n        -570,\n        -317,\n        179,\n        5\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the mural portrait of a man unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"cyan\",\n      \"bbox\": [\n        -448,\n        -43,\n        570,\n        187\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the young man standing unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"orange\",\n      \"bbox\": [\n        12,\n        -43,\n        459,\n        193\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the khaki baggy trousers unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"purple\",\n      \"bbox\": [\n        -276,\n        -34,\n        19,\n        183\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the red and green Portugal jersey unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"lime\",\n      \"bbox\": [\n        -545,\n        182,\n        -198,\n        355\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the Portuguese football crest unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"pink\",\n      \"bbox\": [\n        -74,\n        338,\n        208,\n        453\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the green statue silhouette unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"teal\",\n      \"bbox\": [\n        447,\n        -34,\n        570,\n        193\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the black canvas sneakers unchanged.\"\n    },\n    {\n      \"operation\": \"keep\",\n      \"color\": \"brown\",\n      \"bbox\": [\n        432,\n        -266,\n        578,\n        -124\n      ],\n      \"ref_index\": -1,\n      \"z_index\": 0,\n      \"caption\": \"Keep the yellow and green football unchanged.\"\n    }\n  ]\n}"
